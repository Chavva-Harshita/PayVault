# Copy this file to .env and fill in real values. Never commit .env.

# ---- JWT ----
# Used by auth-service (issues tokens), api-gateway (validates them at the
# REST edge, from Phase 7), and transaction-service (validates them on the
# WebSocket STOMP CONNECT frame, from Phase 11). All three must be
# configured with the exact same value or token validation will fail
# wherever it's checked.
JWT_SECRET=4E449233692B98A394F584EEC7D769EC8B8DB05691C3B492DC8AD692134F38A9
JWT_EXPIRATION_MS=3600000

# ---- MongoDB connection (shared cluster, separate logical databases per service) ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE_AUTH=payvault_auth
MONGODB_DATABASE_USERS=payvault_users
MONGODB_DATABASE_WALLETS=payvault_wallets
MONGODB_DATABASE_TRANSACTIONS=payvault_transactions

# ---- Eureka ----
EUREKA_SERVER_URL=http://localhost:8761/eureka

# ---- Service ports (defaults; wallet-service instance 2 overrides to 8093) ----
EUREKA_SERVER_PORT=8761
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
WALLET_SERVICE_PORT=8083
TRANSACTION_SERVICE_PORT=8084

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5174
